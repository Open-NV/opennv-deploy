# Compose provides local-only demo defaults and binds services to 127.0.0.1.
# Override every token before exposing a service beyond one developer machine.
EXECUTOR_TOKEN=generate-with-openssl-rand-hex-32
EXECUTOR_RELOAD_TOKEN=generate-a-different-value-with-openssl-rand-hex-32
CLISYNTH_RELOAD_TOKEN=generate-another-different-value-with-openssl-rand-hex-32

# Configure these only when deliberately enabling real-device execution.
OPENNV_CREDENTIAL_LAB_USERNAME=read-only-automation-user
OPENNV_CREDENTIAL_LAB_PASSWORD=replace-with-a-secret-manager-reference
